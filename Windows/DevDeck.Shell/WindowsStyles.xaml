<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="DevDeckSans">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DevDeckMono">Cascadia Mono, Consolas</FontFamily>

  <SolidColorBrush x:Key="TextPrimary" Color="#F2FFFFFF" />
  <SolidColorBrush x:Key="TextSecondary" Color="#A8FFFFFF" />
  <SolidColorBrush x:Key="TextTertiary" Color="#6BFFFFFF" />
  <SolidColorBrush x:Key="ToneGood" Color="#70C799" />
  <SolidColorBrush x:Key="ToneAttention" Color="#F0C26B" />
  <SolidColorBrush x:Key="ToneAlert" Color="#E88484" />
  <SolidColorBrush x:Key="TonePersonal" Color="#A99BE0" />
  <SolidColorBrush x:Key="LinkInfo" Color="#7FAEDD" />
  <SolidColorBrush x:Key="EnvironmentInfo" Color="#A99BE0" />
  <SolidColorBrush x:Key="ControlFill" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="ControlHover" Color="#17FFFFFF" />
  <SolidColorBrush x:Key="ControlPressed" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="ControlStroke" Color="#17FFFFFF" />
  <SolidColorBrush x:Key="SeparatorStroke" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="FocusOuter" Color="#F2FFFFFF" />
  <SolidColorBrush x:Key="FocusInner" Color="#FF202024" />
  <SolidColorBrush x:Key="MenuFill" Color="#FA2B2B2F" />
  <SolidColorBrush x:Key="MenuHover" Color="#24FFFFFF" />

  <Style x:Key="DeckMenuItem" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource DevDeckSans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <Border
                x:Name="ItemBackground"
                Background="{TemplateBinding Background}"
                CornerRadius="4"
                MinHeight="28">
              <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="CheckGlyph"
                    Text="&#xE73E;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Foreground="{StaticResource TextPrimary}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
                <ContentPresenter
                    Grid.Column="1"
                    ContentSource="Header"
                    VerticalAlignment="Center"
                    RecognizesAccessKey="False" />
                <TextBlock
                    Grid.Column="2"
                    Text="{TemplateBinding InputGestureText}"
                    Foreground="{StaticResource TextSecondary}"
                    Margin="12,0,4,0"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="SubmenuGlyph"
                    Grid.Column="3"
                    Text="&#xE76C;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="11"
                    Foreground="{StaticResource TextSecondary}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
              </Grid>
            </Border>
            <Popup
                x:Name="PART_Popup"
                Placement="Right"
                IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                AllowsTransparency="True"
                Focusable="False"
                PopupAnimation="Fade">
              <Border
                  Background="{StaticResource MenuFill}"
                  BorderBrush="{StaticResource ControlStroke}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="4">
                <ItemsPresenter />
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource MenuHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="SubmenuGlyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DeckMenuSeparator" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{StaticResource SeparatorStroke}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DeckContextMenu" TargetType="ContextMenu">
    <Setter Property="Background" Value="{StaticResource MenuFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6"
              Padding="{TemplateBinding Padding}">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FluentButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource ControlFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource DevDeckSans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
              x:Name="FocusBorder"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="2"
              CornerRadius="6">
            <Border
                x:Name="ControlBorder"
                Margin="2"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4">
              <ContentPresenter
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="Center"
                  Margin="{TemplateBinding Padding}"
                  RecognizesAccessKey="False" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ControlBorder" Property="Background" Value="{StaticResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ControlBorder" Property="Background" Value="{StaticResource ControlPressed}" />
              <Setter Property="Foreground" Value="#CCFFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ControlBorder" Property="Background" Value="Transparent" />
              <Setter TargetName="ControlBorder" Property="Opacity" Value="0.42" />
              <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource FocusOuter}" />
              <Setter TargetName="ControlBorder" Property="BorderBrush" Value="{StaticResource FocusInner}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PromptTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource ControlFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource DevDeckSans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border
              x:Name="FocusBorder"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="2"
              CornerRadius="6">
            <Border
                x:Name="ControlBorder"
                Margin="2"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
              <Grid>
                <ScrollViewer
                    x:Name="PART_ContentHost"
                    Margin="{TemplateBinding Padding}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="Placeholder"
                    Text="{TemplateBinding Tag}"
                    Margin="{TemplateBinding Padding}"
                    Foreground="{StaticResource TextTertiary}"
                    FontFamily="{TemplateBinding FontFamily}"
                    FontSize="{TemplateBinding FontSize}"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
              </Grid>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource FocusOuter}" />
              <Setter TargetName="ControlBorder" Property="BorderBrush" Value="{StaticResource FocusInner}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>

  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="ExpanderButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ExpanderButton}">
    <Setter Property="Foreground" Value="{StaticResource LinkInfo}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="3,0" />
  </Style>

  <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
</ResourceDictionary>
