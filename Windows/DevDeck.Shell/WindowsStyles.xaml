<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="DevDeckSans">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DevDeckMono">Cascadia Mono, Consolas</FontFamily>
  <!-- The palette's brushes are not here: WindowsTheme puts them in the application's resources
       before this dictionary loads, so they can change colour when the Windows scheme changes. -->


  <Style x:Key="DeckMenuItem" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource DevDeckSans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <Border
                x:Name="ItemBackground"
                Background="{TemplateBinding Background}"
                CornerRadius="4"
                MinHeight="28">
              <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="CheckGlyph"
                    Text="&#xE73E;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Foreground="{DynamicResource TextPrimary}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
                <ContentPresenter
                    Grid.Column="1"
                    ContentSource="Header"
                    VerticalAlignment="Center"
                    RecognizesAccessKey="False" />
                <TextBlock
                    Grid.Column="2"
                    Text="{TemplateBinding InputGestureText}"
                    Foreground="{DynamicResource TextSecondary}"
                    Margin="12,0,4,0"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="SubmenuGlyph"
                    Grid.Column="3"
                    Text="&#xE76C;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
              </Grid>
            </Border>
            <Popup
                x:Name="PART_Popup"
                Placement="Right"
                IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                AllowsTransparency="True"
                Focusable="False"
                PopupAnimation="Fade">
              <Border
                  Background="{DynamicResource MenuFill}"
                  BorderBrush="{DynamicResource ControlStroke}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="4">
                <ItemsPresenter />
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource MenuHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="SubmenuGlyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DeckMenuSeparator" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{DynamicResource SeparatorStroke}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DeckContextMenu" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource MenuFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6"
              Padding="{TemplateBinding Padding}">
            <!-- A menu taller than the screen scrolls by wheel and keyboard rather than running off
                 its bottom; the bar stays hidden like the scroll of a Windows menu. -->
            <ScrollViewer
                x:Name="MenuScroll"
                VerticalScrollBarVisibility="Hidden"
                HorizontalScrollBarVisibility="Disabled"
                CanContentScroll="False">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FluentButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ControlFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource DevDeckSans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
              x:Name="FocusBorder"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="2"
              CornerRadius="6">
            <Border
                x:Name="ControlBorder"
                Margin="2"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4">
              <ContentPresenter
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="Center"
                  Margin="{TemplateBinding Padding}"
                  RecognizesAccessKey="False" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ControlBorder" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ControlBorder" Property="Background" Value="{DynamicResource ControlPressed}" />
              <Setter Property="Foreground" Value="{DynamicResource PressedText}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ControlBorder" Property="Background" Value="Transparent" />
              <Setter TargetName="ControlBorder" Property="Opacity" Value="0.42" />
              <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource FocusOuter}" />
              <Setter TargetName="ControlBorder" Property="BorderBrush" Value="{DynamicResource FocusInner}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PromptTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource ControlFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource DevDeckSans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border
              x:Name="FocusBorder"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="2"
              CornerRadius="6">
            <Border
                x:Name="ControlBorder"
                Margin="2"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
              <Grid>
                <ScrollViewer
                    x:Name="PART_ContentHost"
                    Margin="{TemplateBinding Padding}"
                    Foreground="{TemplateBinding Foreground}"
                    Focusable="False"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="Placeholder"
                    Text="{TemplateBinding Tag}"
                    Margin="{TemplateBinding Padding}"
                    Foreground="{DynamicResource TextTertiary}"
                    FontFamily="{TemplateBinding FontFamily}"
                    FontSize="{TemplateBinding FontSize}"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
              </Grid>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource FocusOuter}" />
              <Setter TargetName="ControlBorder" Property="BorderBrush" Value="{DynamicResource FocusInner}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Cards draw the focus ring outside the button, so the visible control fills its layout box and
       sits on the card's content edge, as in the reference mock. -->
  <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border
                x:Name="FocusBorder"
                Margin="-4"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="2"
                CornerRadius="6"
                IsHitTestVisible="False" />
            <Border
                x:Name="ControlBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4">
              <ContentPresenter
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="Center"
                  Margin="{TemplateBinding Padding}"
                  RecognizesAccessKey="False" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ControlBorder" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ControlBorder" Property="Background" Value="{DynamicResource ControlPressed}" />
              <Setter Property="Foreground" Value="{DynamicResource PressedText}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ControlBorder" Property="Background" Value="Transparent" />
              <Setter TargetName="ControlBorder" Property="Opacity" Value="0.42" />
              <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource FocusOuter}" />
              <Setter TargetName="ControlBorder" Property="BorderBrush" Value="{DynamicResource FocusInner}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="CardRowButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="ExpanderButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
    <Setter Property="Height" Value="26" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource LinkInfo}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="3,0" />
  </Style>

  <Style x:Key="CardLinkButton" TargetType="Button" BasedOn="{StaticResource ExpanderButton}">
    <Setter Property="Foreground" Value="{DynamicResource LinkInfo}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="3,0" />
  </Style>

  <Style x:Key="SettingsToggle" TargetType="CheckBox">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid>
            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{DynamicResource ToggleStroke}" Background="Transparent" />
            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{DynamicResource ToggleThumb}"
                     HorizontalAlignment="Left" Margin="4,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleOnFill}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleOnFill}" />
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource ToggleOnThumb}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Opacity" Value="0.35" />
              <Setter TargetName="Thumb" Property="Opacity" Value="0.35" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FocusOuter}" />
              <Setter TargetName="Track" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource DevDeckSans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border
              x:Name="ItemBackground"
              Background="Transparent"
              CornerRadius="4"
              Padding="{TemplateBinding Padding}">
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="Center"
                RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource MenuHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsListBoxItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource DevDeckSans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border
              x:Name="ItemBackground"
              Background="Transparent"
              CornerRadius="4"
              Padding="{TemplateBinding Padding}">
            <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource MenuHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsComboBox" TargetType="ComboBox">
    <Setter Property="Height" Value="32" />
    <!-- The text is centred; vertical padding only cut the descenders off. -->
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{DynamicResource ControlFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource DevDeckSans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border
                x:Name="FocusBorder"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="2"
                CornerRadius="6">
              <Border
                  x:Name="ControlBorder"
                  Margin="2"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter
                      Margin="{TemplateBinding Padding}"
                      Content="{TemplateBinding SelectionBoxItem}"
                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      RecognizesAccessKey="False" />
                  <TextBlock
                      Grid.Column="1"
                      Text="&#xE70D;"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="11"
                      Foreground="{DynamicResource TextSecondary}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False" />
                  <ToggleButton
                      x:Name="DropDownToggle"
                      Grid.ColumnSpan="2"
                      Background="Transparent"
                      BorderThickness="0"
                      Focusable="False"
                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                </Grid>
              </Border>
            </Border>
            <Popup
                x:Name="PART_Popup"
                Placement="Bottom"
                IsOpen="{TemplateBinding IsDropDownOpen}"
                AllowsTransparency="True"
                Focusable="False"
                PopupAnimation="Fade">
              <Border
                  MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                  MaxHeight="320"
                  Background="{DynamicResource MenuFill}"
                  BorderBrush="{DynamicResource ControlStroke}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger SourceName="DropDownToggle" Property="IsMouseOver" Value="True">
              <Setter TargetName="ControlBorder" Property="Background" Value="{DynamicResource ControlHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource FocusOuter}" />
              <Setter TargetName="ControlBorder" Property="BorderBrush" Value="{DynamicResource FocusInner}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsPasswordBox" TargetType="PasswordBox">
    <Setter Property="Background" Value="{DynamicResource ControlFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource DevDeckMono}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <!-- A Windows 11 scroll bar: a thin rounded thumb on a clear track, so the settings and log
       windows do not show the classic light bar on a dark surface. -->
  <Style x:Key="DeckScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{DynamicResource TextTertiary}" CornerRadius="3" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DeckScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource DeckScrollPage}" Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource DeckScrollThumb}" Margin="3,2" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource DeckScrollPage}" Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource DeckScrollPage}" Command="ScrollBar.PageLeftCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource DeckScrollThumb}" Margin="2,3" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource DeckScrollPage}" Command="ScrollBar.PageRightCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
